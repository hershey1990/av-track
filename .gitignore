# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build artifacts
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# mcp config (may contain access tokens)
.mcp.json
opencode.json

# kun plans
/.kunsdd/

# vercel
.vercel

# serwist
public/sw*
public/swe-worker*

# kiro (AI skill files)
/.kiro/

# typescript
*.tsbuildinfo
next-env.d.ts
